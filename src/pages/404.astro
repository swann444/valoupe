---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page introuvable">
  <section class="section">
    <div class="wrap head center">
      <span class="etiq">Erreur 404</span>
      <h1 class="h-xl">Même à la loupe,<br /><mark>rien ici.</mark></h1>
      <p class="lead">Cette page n’existe pas ou a été déplacée.</p>
      <a class="btn" href={url()}>Retour à l’accueil</a>
    </div>
  </section>
</Base>
