---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { url } from '../lib/url';
const couleurs = [
  { n: 'Nuit', h: '#0B1A16', r: 'Texte, fonds sombres, logo', fg: '#F5F2EA' },
  { n: 'Pin', h: '#0F5E4B', r: 'Couleur principale, liens, valeurs sûres', fg: '#F5F2EA' },
  { n: 'Jade', h: '#3DD6A3', r: 'Gains, accents sur fond sombre', fg: '#0B1A16' },
  { n: 'Étiquette', h: '#FFD23F', r: 'Signature : la lentille, les prix, l’appel à l’action', fg: '#0B1A16' },
  { n: 'Papier', h: '#F5F2EA', r: 'Fond principal, chaleureux', fg: '#0B1A16' },
  { n: 'Lin', h: '#E6E9E1', r: 'Surfaces secondaires', fg: '#0B1A16' },
  { n: 'Ardoise', h: '#55635A', r: 'Texte secondaire', fg: '#F5F2EA' },
  { n: 'Corail', h: '#E4573D', r: 'Pertes, alertes (avec parcimonie)', fg: '#0B1A16' },
];
const fichiers = [
  ['Logo couleur (SVG)', 'valoupe-logo.svg'], ['Logo négatif (SVG)', 'valoupe-logo-negatif.svg'], ['Logo une couleur (SVG)', 'valoupe-logo-mono.svg'],
  ['Symbole (SVG)', 'valoupe-symbole.svg'], ['Icône d’application (SVG)', 'valoupe-icone-app.svg'], ['Icône 1024 px (PNG)', 'valoupe-icone-1024.png'],
  ['Logo 1600 px (PNG)', 'valoupe-logo-1600.png'], ['Logo négatif 1600 px (PNG)', 'valoupe-logo-negatif-1600.png'],
];
---
<Base title="Identité & presse" description="Logo, couleurs, typographies et règles d’usage de la marque Valoupe. Fichiers à télécharger.">
  <section class="page-top">
    <div class="wrap head">
      <span class="kicker reveal">Identité &amp; presse</span>
      <h1 class="h-xl reveal" style="--d:.06s">Une marque <mark>qui inspire confiance.</mark></h1>
      <p class="lead reveal" style="--d:.12s">Sérieuse comme un outil d’expert, chaleureuse comme une boutique de quartier. Voici les éléments de l’identité et leurs règles d’usage.</p>
    </div>
  </section>

  <section class="section tight" style="padding-top:0">
    <div class="wrap grid g2">
      <div class="plaque clair reveal"><Logo class="l-grand" /><span>Logo principal</span></div>
      <div class="plaque sombre reveal" style="--d:.06s"><Logo variante="negatif" class="l-grand" /><span>Sur fond sombre</span></div>
      <div class="plaque jaune reveal"><img src={url('marque/valoupe-logo-mono.svg')} alt="" class="l-mono" /><span>Une couleur (tampon, gravure)</span></div>
      <div class="plaque clair icones reveal" style="--d:.06s">
        <img src={url('marque/valoupe-icone-app.svg')} alt="" width="120" height="120" />
        <img src={url('marque/valoupe-icone-app.svg')} alt="" width="64" height="64" />
        <img src={url('marque/valoupe-icone-app.svg')} alt="" width="32" height="32" />
        <img src={url('marque/valoupe-icone-app.svg')} alt="" width="16" height="16" />
        <span>Icône d’application, lisible jusqu’à 16 px</span>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="head reveal"><span class="kicker">Le symbole</span><h2 class="h-l">Une loupe qui valide.</h2>
        <p class="lead">Le « o » de Valoupe est une loupe : l’outil de l’expert qui examine l’objet. Dans la lentille couleur étiquette, un ✓ : le prix a été vérifié, l’achat peut se faire.</p></div>
      <div class="grid g3">
        <div class="card reveal"><h3>Zone de protection</h3><p>Autour du logo, laisser un espace au moins égal à la hauteur du « a ». Ne jamais coller de texte ou d’image à la loupe.</p></div>
        <div class="card reveal" style="--d:.06s"><h3>Taille minimale</h3><p>Logo complet : 72 px de large à l’écran, 20 mm à l’impression. En dessous, utiliser le symbole seul.</p></div>
        <div class="card reveal" style="--d:.12s"><h3>À éviter</h3><p>Déformer, recolorer la lentille, ajouter une ombre, réécrire le nom dans une autre police, poser le logo couleur sur une photo chargée.</p></div>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="head reveal"><span class="kicker">Couleurs</span><h2 class="h-l">Le vert de l’expert, le jaune de l’étiquette.</h2></div>
      <div class="palette">
        {couleurs.map((c, i) => (
          <div class="pastille reveal" style={`--d:${(i % 4) * .05}s;background:${c.h};color:${c.fg}`}>
            <b>{c.n}</b><span class="num">{c.h}</span><small>{c.r}</small>
          </div>
        ))}
      </div>
      <p class="regle reveal">Proportions conseillées : 60 % Papier ou Nuit, 25 % Pin et Lin, 10 % Étiquette, 5 % pour le reste. Le jaune reste rare pour garder sa force.</p>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap grid g2">
      <div class="card typo reveal"><span class="kicker">Titres</span><p class="t-bric">Bricolage Grotesque</p><p>Caractère, chaleur, chiffres expressifs. Graisses 600 à 800, interlettrage resserré.</p><p class="t-alpha t-bric">Aa 0123 456 €</p></div>
      <div class="card typo reveal" style="--d:.06s"><span class="kicker">Textes</span><p class="t-atk">Atkinson Hyperlegible</p><p>Conçue pour la lisibilité (malvoyance), idéale pour les montants au comptoir. Graisses 400 et 700.</p><p class="t-alpha t-atk">Aa 0123 456 €</p></div>
    </div>
    <p class="wrap regle reveal">Les deux polices sont libres (licence SIL Open Font License) et intégrées à l’application pour fonctionner hors ligne.</p>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="head reveal"><span class="kicker">Téléchargements</span><h2 class="h-m">Fichiers de la marque</h2></div>
      <ul class="fichiers reveal">
        {fichiers.map(([l, f]) => <li><a href={url('marque/' + f)} download>{l}<span>↓</span></a></li>)}
      </ul>
    </div>
  </section>
</Base>
<style>
  .plaque { border-radius: 26px; min-height: 260px; display: grid; place-items: center; position: relative; padding: 40px; border: 1px solid var(--trait); }
  .plaque > span { position: absolute; left: 22px; bottom: 16px; font-size: 13px; font-weight: 700; opacity: .7; }
  .plaque.clair { background: var(--surface); }
  .plaque.sombre { background: var(--nuit); color: var(--papier); }
  .plaque.jaune { background: var(--etiquette); }
  .plaque :global(.l-grand) { height: clamp(56px, 8vw, 92px); }
  .l-mono { height: clamp(56px, 8vw, 92px); width: auto; filter: none; }
  .icones { display: flex; align-items: end; justify-content: center; gap: 22px; flex-wrap: wrap; }
  .palette { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .pastille { border-radius: 22px; padding: 22px; min-height: 170px; display: grid; align-content: end; gap: 2px; border: 1px solid rgba(11,26,22,.08); }
  .pastille b { font: 800 1.4rem var(--display); }
  .pastille small { opacity: .8; font-size: 13.5px; line-height: 1.35; margin-top: 6px; }
  .regle { margin-top: 22px; color: var(--ardoise); }
  .typo { display: grid; gap: 10px; }
  .t-bric { font-family: var(--display); font-weight: 800; font-size: 2rem; letter-spacing: -.03em; color: var(--nuit) !important; }
  .t-atk { font-family: var(--body); font-weight: 700; font-size: 2rem; color: var(--nuit) !important; }
  .t-alpha { font-size: 3.4rem !important; line-height: 1.1; }
  .fichiers { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 10px; }
  .fichiers a { display: flex; justify-content: space-between; padding: 16px 18px; border-radius: 16px; background: var(--surface); border: 1px solid var(--trait); text-decoration: none; font-weight: 700; transition: background .2s, color .2s; }
  .fichiers a:hover { background: var(--nuit); color: var(--papier); }
</style>
